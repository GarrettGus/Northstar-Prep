DATABASE_URL=
SESSION_SECRET=
# Used once by `npm run db:migrate` to create the first owner account when no
# accounts exist yet. Safe to leave set afterward.
HOUSEHOLD_OWNER_EMAIL=
HOUSEHOLD_PASSWORD=
# 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`). Encrypts scheduled
# household backups at rest; without it, automatic backups fail closed.
BACKUP_ENCRYPTION_KEY=
# A random secret (e.g. `openssl rand -hex 32`) shared with Vercel's Cron Jobs so only
# the scheduled trigger for /api/backup can create a backup.
CRON_SECRET=
# Read-write token for a Vercel Blob store, used to store inventory/shopping item images
# outside Postgres. Set automatically when a Blob store is connected to the Vercel project;
# for local development, pull it with the Vercel CLI or create one in the dashboard.
BLOB_READ_WRITE_TOKEN=
# Optional production monitoring. Repeated failed writes or server errors on one route POST a
# JSON alert to this URL (Slack-compatible `text` field plus structured fields); leave it empty
# and the same decision is only written to the server logs as an `alert` event.
ALERT_WEBHOOK_URL=
# Alert tuning: how many failures within how many minutes trigger an alert, and how long to
# wait before alerting again for the same route. Defaults: 5 failures / 15 minutes / 60 minutes.
ALERT_FAILURE_THRESHOLD=
ALERT_WINDOW_MINUTES=
ALERT_COOLDOWN_MINUTES=
# How long request metrics are kept before the daily maintenance run deletes them (default 14).
METRICS_RETENTION_DAYS=
# How long daily readiness snapshots are kept (default 365). Aggregate figures only, never item contents.
READINESS_HISTORY_RETENTION_DAYS=
