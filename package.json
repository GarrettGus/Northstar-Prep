{
  "name": "northstar-prep",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.js",
    "test:e2e:app": "playwright test --config tests/e2e/app.config.js",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.js",
    "db:migrate-images": "node --env-file-if-exists=.env.local scripts/migrate-images.js",
    "restore-off-site-backup": "node --env-file-if-exists=.env.local scripts/restore-off-site-backup.js",
    "smoke-test": "node scripts/smoketest.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "pg": "^8.23.0",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
